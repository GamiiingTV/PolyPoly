# ============================================================
# PolyPoly — Environment Variables Template
# Copie ce fichier en .env et remplis tes vraies valeurs
# ============================================================

# --- Polymarket ---
POLYMARKET_PRIVATE_KEY=0xTON_PRIVATE_KEY_POLYGON_WALLET
POLYMARKET_API_KEY=TON_API_KEY
POLYMARKET_API_SECRET=TON_API_SECRET
POLYMARKET_API_PASSPHRASE=TON_PASSPHRASE
POLYMARKET_PROXY_ADDRESS=ADRESSE_PROXY_OPTIONNEL

# --- LLM (utilise Claude ou OpenAI) ---
ANTHROPIC_API_KEY=sk-ant-XXXXXXXXXXXXXXXXXXXXXXXX
OPENAI_API_KEY=sk-XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# --- Twitter / X API ---
TWITTER_BEARER_TOKEN=AAAAAAAAAAAAAAAAAAA
TWITTER_API_KEY=TON_API_KEY
TWITTER_API_SECRET=TON_API_SECRET
TWITTER_ACCESS_TOKEN=TON_ACCESS_TOKEN
TWITTER_ACCESS_TOKEN_SECRET=TON_ACCESS_TOKEN_SECRET

# --- Reddit ---
REDDIT_CLIENT_ID=TON_CLIENT_ID
REDDIT_CLIENT_SECRET=TON_CLIENT_SECRET
REDDIT_USER_AGENT=PolyPolyBot/1.0 by u/TON_USERNAME

# --- Telegram ---
TELEGRAM_BOT_TOKEN=1234567890:ABCDEFGHIJKLMNOPQRSTUVWXYZ
TELEGRAM_CHAT_ID=TON_CHAT_ID

# --- Configuration Trading ---
MAX_TRADE_SIZE_USD=5.0
MIN_CONFIDENCE_THRESHOLD=0.72
MIN_EDGE_THRESHOLD=0.05
MIN_LIQUIDITY_USD=1000
MIN_VOLUME_24H_USD=500
MAX_OPEN_POSITIONS=10
CAPITAL_USD=100.0
DAILY_LOSS_LIMIT_USD=15.0

# --- Configuration Réseau ---
POLYGON_RPC_URL=https://polygon-rpc.com

# --- Base de Données ---
DATABASE_PATH=data/polypoly.db

# --- Logging ---
LOG_LEVEL=INFO
LOG_FILE=logs/polypoly.log

# ============================================================
# MemeCrawler (memecoins Solana) — python -m memecrawler
# ============================================================
# live = VRAI argent via Jupiter | paper = simulation
MC_MODE=live
# Clé privée base58 d'un wallet DÉDIÉ (export Phantom/Solflare). N'y mets que ce que tu acceptes de perdre.
SOLANA_PRIVATE_KEY=
# Un RPC privé (Helius, QuickNode…) est fortement conseillé, le public est lent/limité
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
JUPITER_API_URL=https://lite-api.jup.ag/swap/v1
JUPITER_API_KEY=
MC_JEV_MODEL=claude-haiku-5-5
MC_TICKET_PCT=0.20
MC_MAX_TICKET_USD=50
MC_DAILY_LOSS_LIMIT_USD=30
MC_SLIPPAGE_BPS=300
MC_STOP_LOSS=0.12
MC_FLUSH_PCT=0.25
