# ============================================================
# PolyPoly — Environment Variables Template
# Copie ce fichier en .env et remplis tes vraies valeurs
# ============================================================

# --- Polymarket ---
POLYMARKET_PRIVATE_KEY=0xTON_PRIVATE_KEY_POLYGON_WALLET
POLYMARKET_API_KEY=TON_API_KEY
POLYMARKET_API_SECRET=TON_API_SECRET
POLYMARKET_API_PASSPHRASE=TON_PASSPHRASE
POLYMARKET_PROXY_ADDRESS=ADRESSE_PROXY_OPTIONNEL

# --- LLM (utilise Claude ou OpenAI) ---
ANTHROPIC_API_KEY=sk-ant-XXXXXXXXXXXXXXXXXXXXXXXX
OPENAI_API_KEY=sk-XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# --- Twitter / X API ---
TWITTER_BEARER_TOKEN=AAAAAAAAAAAAAAAAAAA
TWITTER_API_KEY=TON_API_KEY
TWITTER_API_SECRET=TON_API_SECRET
TWITTER_ACCESS_TOKEN=TON_ACCESS_TOKEN
TWITTER_ACCESS_TOKEN_SECRET=TON_ACCESS_TOKEN_SECRET

# --- Reddit ---
REDDIT_CLIENT_ID=TON_CLIENT_ID
REDDIT_CLIENT_SECRET=TON_CLIENT_SECRET
REDDIT_USER_AGENT=PolyPolyBot/1.0 by u/TON_USERNAME

# --- Telegram ---
TELEGRAM_BOT_TOKEN=1234567890:ABCDEFGHIJKLMNOPQRSTUVWXYZ
TELEGRAM_CHAT_ID=TON_CHAT_ID

# --- Configuration Trading ---
MAX_TRADE_SIZE_USD=5.0
MIN_CONFIDENCE_THRESHOLD=0.72
MIN_EDGE_THRESHOLD=0.05
MIN_LIQUIDITY_USD=1000
MIN_VOLUME_24H_USD=500
MAX_OPEN_POSITIONS=10
CAPITAL_USD=100.0
DAILY_LOSS_LIMIT_USD=15.0

# --- Configuration Réseau ---
POLYGON_RPC_URL=https://polygon-rpc.com

# --- Base de Données ---
DATABASE_PATH=data/polypoly.db

# --- Logging ---
LOG_LEVEL=INFO
LOG_FILE=logs/polypoly.log

# ============================================================
# HFT BTC Polymarket Bot
# ============================================================

# --- Capital et Risque ---
HFT_CAPITAL_USD=150.0           # Ton dépôt initial ($150 minimum recommandé)
HFT_RISK_PER_TRADE=0.015        # 1.5% par trade (augmenté pour petits capitaux)
HFT_DAILY_RISK_LIMIT=0.05       # 5% limite journalière
HFT_HARD_STOP=0.008             # 0.8% arrêt dur par trade

# --- Compound automatique ---
# Chaque gain augmente le capital actif → positions suivantes plus grosses.
# La RESERVE est intouchable : protection contre la ruine totale.
HFT_COMPOUND_ENABLED=true       # Réinvestir les gains automatiquement
HFT_RESERVE_PCT=0.20            # 20% du capital en réserve (jamais risqué)
HFT_MIN_ORDER_USD=1.0           # Plancher minimum Polymarket ($1)
HFT_FIXED_TRADE_USD=5.0         # 0 = Kelly % dynamique, >0 = montant fixe par trade ($)

# --- Filtres marché ---
HFT_MIN_LIQUIDITY=5000.0        # Liquidité min Polymarket ($)
HFT_MAX_SPREAD=0.02             # Spread bid-ask max (2%)

# --- CryptoQuant (optionnel — fallback Binance public si absent) ---
# Inscription : https://cryptoquant.com (plan gratuit disponible)
CRYPTOQUANT_API_KEY=

# --- Logging HFT ---
HFT_LOG_LEVEL=INFO
